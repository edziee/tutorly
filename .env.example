# Copy this file to .env.local and fill in the values from the Firebase console
# (Project settings > Your apps > Web app config). .env*.local is ignored by git.
#
# Expo only exposes variables that start with EXPO_PUBLIC_, and it inlines them
# into the app bundle, so anyone can read them in a built app. Keep real secrets
# (service account keys, admin passwords) out of this file. Data access is
# protected by Firestore and Storage security rules.
#
# Read them in code with dot notation, for example process.env.EXPO_PUBLIC_FIREBASE_API_KEY.
# Do not destructure process.env or use bracket notation; Expo will not inline those.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Public Google Forms links for manually verified token requests. These links
# are included in the app bundle; never put private credentials here.
EXPO_PUBLIC_STUDENT_TOKEN_TOPUP_FORM_URL=
EXPO_PUBLIC_TUTOR_TOKEN_CASHOUT_FORM_URL=

# Campus location for the session check-in (Member 2, Week 3). Leave the
# coordinates empty until the team picks the campus. These are map coordinates,
# not secrets. The radius is in meters (default 200).
EXPO_PUBLIC_CAMPUS_LATITUDE=
EXPO_PUBLIC_CAMPUS_LONGITUDE=
EXPO_PUBLIC_CAMPUS_RADIUS_METERS=200
