rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function tutorPath(uid) {
      return /databases/$(database)/documents/tutors/$(uid);
    }

    function applicationPath(uid) {
      return /databases/$(database)/documents/tutorApplications/$(uid);
    }

    function walletPath(uid) {
      return /databases/$(database)/documents/wallets/$(uid);
    }

    function tokenTransactionPath(transactionId) {
      return /databases/$(database)/documents/tokenTransactions/$(transactionId);
    }

    function bookingPath(bookingId) {
      return /databases/$(database)/documents/bookings/$(bookingId);
    }

    function studentBadgeAwardPath(bookingId) {
      return /databases/$(database)/documents/bookings/$(bookingId)/badgeAwards/award;
    }

    function tutorAchievementPath(uid, badgeId) {
      return /databases/$(database)/documents/tutorAchievements/$(uid + '_' + badgeId);
    }

    function tutorAchievementDocumentPath(achievementId) {
      return /databases/$(database)/documents/tutorAchievements/$(achievementId);
    }

    function hasAccount() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function accountRole() {
      return hasAccount() ? get(userPath(request.auth.uid)).data.get('role', '') : '';
    }

    function isAdmin() {
      return accountRole() == 'admin';
    }

    function isStudent() {
      return accountRole() == 'student';
    }

    function isTutor() {
      return accountRole() in ['tutor', 'professional'];
    }

    function isTutorAccountType(tutorType) {
      return (
        (accountRole() == 'tutor' &&
          get(userPath(request.auth.uid)).data.get('tutorType', '') == tutorType) ||
        (accountRole() == 'professional' && tutorType == 'professional')
      );
    }

    function validProfileVersion(data) {
      return data.get('publicProfileVersion', 0) == 2;
    }

    function validTokenPrice(price) {
      let fraction = (price * 100) % 1;
      return price is number &&
        price > 0 &&
        (fraction <= 0.000001 || fraction >= 0.999999);
    }

    function tokenPriceMatchesUnits(price, units) {
      let scaledPrice = price * 100;
      return validTokenPrice(price) &&
        units is int &&
        units > 0 &&
        scaledPrice >= units - 0.000001 &&
        scaledPrice <= units + 0.000001;
    }

    function validTutorTokenRate(tutorType, price) {
      return validTokenPrice(price) &&
        ((tutorType == 'peer' && price >= 200) ||
          (tutorType == 'professional' && price >= 300));
    }

    function validWalletShape(data) {
      return data.keys().hasOnly([
          'availableUnits',
          'heldUnits',
          'createdAt',
          'updatedAt',
          'lastTransactionId'
        ]) &&
        data.keys().hasAll([
          'availableUnits',
          'heldUnits',
          'createdAt',
          'updatedAt'
        ]) &&
        data.availableUnits is int &&
        data.availableUnits >= 0 &&
        data.heldUnits is int &&
        data.heldUnits >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (!('lastTransactionId' in data) || data.lastTransactionId is string);
    }

    function validWalletInitialization(uid) {
      let account = getAfter(userPath(uid)).data;
      return signedIn() &&
        existsAfter(userPath(uid)) &&
        account.get('role', '') in ['student', 'tutor', 'professional'] &&
        request.resource.data.availableUnits == 0 &&
        request.resource.data.heldUnits == 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        !('lastTransactionId' in request.resource.data) &&
        validWalletShape(request.resource.data) &&
        ((request.auth.uid == uid) ||
          isAdmin());
    }

    function validLedgerBase(transactionId, entry) {
      return entry.keys().hasOnly([
          'type',
          'accountId',
          'amountUnits',
          'availableDelta',
          'heldDelta',
          'actorUid',
          'reason',
          'formReference',
          'bookingId',
          'createdAt'
        ]) &&
        entry.keys().hasAll([
          'type',
          'accountId',
          'amountUnits',
          'availableDelta',
          'heldDelta',
          'actorUid',
          'reason',
          'formReference',
          'createdAt'
        ]) &&
        entry.accountId is string &&
        entry.amountUnits is int &&
        entry.amountUnits > 0 &&
        entry.availableDelta is int &&
        entry.heldDelta is int &&
        entry.actorUid == request.auth.uid &&
        entry.reason is string &&
        entry.reason.size() <= 300 &&
        entry.formReference is string &&
        entry.formReference.size() <= 200 &&
        entry.createdAt == request.time &&
        exists(walletPath(entry.accountId)) &&
        existsAfter(walletPath(entry.accountId)) &&
        getAfter(walletPath(entry.accountId)).data.lastTransactionId == transactionId &&
        getAfter(walletPath(entry.accountId)).data.availableUnits -
          get(walletPath(entry.accountId)).data.availableUnits == entry.availableDelta &&
        getAfter(walletPath(entry.accountId)).data.heldUnits -
          get(walletPath(entry.accountId)).data.heldUnits == entry.heldDelta;
    }

    function validAdminWalletEntry(transactionId, entry) {
      let account = get(userPath(entry.accountId)).data;
      return isAdmin() &&
        account.get('role', '') in ['student', 'tutor', 'professional'] &&
        entry.type in ['admin_credit', 'admin_debit'] &&
        entry.formReference.size() > 0 &&
        entry.heldDelta == 0 &&
        ((entry.type == 'admin_credit' &&
            entry.availableDelta == entry.amountUnits) ||
          (entry.type == 'admin_debit' &&
            entry.availableDelta == -entry.amountUnits)) &&
        validLedgerBase(transactionId, entry);
    }

    function validBookingAcceptanceEntry(transactionId, entry) {
      let booking = getAfter(bookingPath(entry.bookingId)).data;
      return entry.type == 'booking_acceptance' &&
        validBookingTokenSplit(booking) &&
        isApprovedTutor(entry.actorUid) &&
        booking.status == 'upcoming' &&
        booking.tokenStatus == 'reserved' &&
        entry.accountId == booking.studentId &&
        entry.actorUid == booking.tutorId &&
        entry.amountUnits == booking.tokenAmountUnits &&
        entry.availableDelta == -booking.tokenAmountUnits &&
        entry.heldDelta ==
          booking.tokenAmountUnits - booking.tokenDepositUnits &&
        getAfter(tokenTransactionPath(
          entry.bookingId + '_deposit_hold'
        )).data.type == 'booking_deposit_hold' &&
        validLedgerBase(transactionId, entry);
    }

    function validBookingDepositHoldEntry(transactionId, entry) {
      let booking = getAfter(bookingPath(entry.bookingId)).data;
      let acceptance = getAfter(tokenTransactionPath(
        entry.bookingId + '_acceptance'
      )).data;
      return entry.type == 'booking_deposit_hold' &&
        validBookingTokenSplit(booking) &&
        isApprovedTutor(entry.actorUid) &&
        booking.status == 'upcoming' &&
        booking.tokenStatus == 'reserved' &&
        entry.accountId == booking.tutorId &&
        entry.actorUid == booking.tutorId &&
        entry.amountUnits == booking.tokenDepositUnits &&
        entry.availableDelta == 0 &&
        entry.heldDelta == booking.tokenDepositUnits &&
        acceptance.type == 'booking_acceptance' &&
        acceptance.accountId == booking.studentId &&
        acceptance.amountUnits == booking.tokenAmountUnits &&
        validLedgerBase(transactionId, entry);
    }

    function validBookingRefundEntry(transactionId, entry) {
      let booking = getAfter(bookingPath(entry.bookingId)).data;
      return entry.type == 'booking_refund' &&
        entry.accountId == booking.studentId &&
        entry.amountUnits == booking.tokenAmountUnits &&
        entry.availableDelta == entry.amountUnits &&
        booking.status in ['rejected', 'cancelled'] &&
        booking.tokenStatus == 'refunded' &&
        (entry.actorUid == booking.studentId ||
          entry.actorUid == booking.tutorId) &&
        (entry.actorUid == booking.studentId ||
          isApprovedTutor(entry.actorUid)) &&
        (('tokenDepositUnits' in booking)
          ? (validBookingTokenSplit(booking) &&
              booking.status == 'cancelled' &&
              entry.heldDelta ==
                -(booking.tokenAmountUnits - booking.tokenDepositUnits) &&
              getAfter(tokenTransactionPath(
                entry.bookingId + '_deposit_refund'
              )).data.type == 'booking_deposit_refund')
          : entry.heldDelta == -entry.amountUnits) &&
        validLedgerBase(transactionId, entry);
    }

    function validBookingDepositRefundEntry(transactionId, entry) {
      let booking = getAfter(bookingPath(entry.bookingId)).data;
      let refund = getAfter(tokenTransactionPath(
        entry.bookingId + '_refund'
      )).data;
      return entry.type == 'booking_deposit_refund' &&
        validBookingTokenSplit(booking) &&
        booking.status == 'cancelled' &&
        booking.tokenStatus == 'refunded' &&
        entry.accountId == booking.tutorId &&
        entry.actorUid == refund.actorUid &&
        entry.amountUnits == booking.tokenDepositUnits &&
        entry.availableDelta == 0 &&
        entry.heldDelta == -booking.tokenDepositUnits &&
        refund.type == 'booking_refund' &&
        refund.accountId == booking.studentId &&
        refund.amountUnits == booking.tokenAmountUnits &&
        validLedgerBase(transactionId, entry);
    }

    function validBookingSettlementDebit(transactionId, entry) {
      let booking = getAfter(bookingPath(entry.bookingId)).data;
      let credit = getAfter(tokenTransactionPath(
        entry.bookingId + '_settlement_credit'
      )).data;
      let tutorWallet = getAfter(walletPath(booking.tutorId)).data;
      return entry.type == 'booking_settlement_debit' &&
        entry.accountId == booking.studentId &&
        entry.actorUid == booking.tutorId &&
        entry.availableDelta == 0 &&
        booking.status == 'completed' &&
        booking.tokenStatus == 'settled' &&
        isApprovedTutor(entry.actorUid) &&
        credit.type == 'booking_settlement_credit' &&
        credit.accountId == booking.tutorId &&
        credit.actorUid == entry.actorUid &&
        ((('tokenDepositUnits' in booking) &&
            validBookingTokenSplit(booking) &&
            entry.amountUnits ==
              booking.tokenAmountUnits - booking.tokenDepositUnits &&
            entry.heldDelta == -entry.amountUnits &&
            credit.amountUnits == booking.tokenAmountUnits &&
            credit.availableDelta == booking.tokenAmountUnits &&
            credit.heldDelta == -booking.tokenDepositUnits &&
            tutorWallet.availableUnits ==
              get(walletPath(booking.tutorId)).data.availableUnits +
                booking.tokenAmountUnits &&
            tutorWallet.heldUnits ==
              get(walletPath(booking.tutorId)).data.heldUnits -
                booking.tokenDepositUnits) ||
          (!('tokenDepositUnits' in booking) &&
            entry.amountUnits == booking.tokenAmountUnits &&
            entry.heldDelta == -entry.amountUnits &&
            credit.amountUnits == entry.amountUnits &&
            tutorWallet.availableUnits ==
              get(walletPath(booking.tutorId)).data.availableUnits +
                entry.amountUnits &&
            tutorWallet.heldUnits ==
              get(walletPath(booking.tutorId)).data.heldUnits)) &&
        validLedgerBase(transactionId, entry);
    }

    function validBookingSettlementCredit(transactionId, entry) {
      let booking = getAfter(bookingPath(entry.bookingId)).data;
      let debit = getAfter(tokenTransactionPath(
        entry.bookingId + '_settlement_debit'
      )).data;
      let studentWallet = getAfter(walletPath(booking.studentId)).data;
      return       entry.type == 'booking_settlement_credit' &&
      entry.accountId == booking.tutorId &&
      entry.actorUid == booking.tutorId &&
      entry.amountUnits == booking.tokenAmountUnits &&
      entry.availableDelta == entry.amountUnits &&
      booking.status == 'completed' &&
        booking.tokenStatus == 'settled' &&
        isApprovedTutor(entry.actorUid) &&
        debit.type == 'booking_settlement_debit' &&
        debit.accountId == booking.studentId &&
        debit.actorUid == entry.actorUid &&
        studentWallet.availableUnits ==
          get(walletPath(booking.studentId)).data.availableUnits &&
        ((('tokenDepositUnits' in booking) &&
            validBookingTokenSplit(booking) &&
            entry.amountUnits == booking.tokenAmountUnits &&
            entry.availableDelta == entry.amountUnits &&
            entry.heldDelta == -booking.tokenDepositUnits &&
            debit.amountUnits ==
              booking.tokenAmountUnits - booking.tokenDepositUnits &&
            studentWallet.heldUnits ==
              get(walletPath(booking.studentId)).data.heldUnits -
                (booking.tokenAmountUnits - booking.tokenDepositUnits)) ||
          (!('tokenDepositUnits' in booking) &&
            entry.amountUnits == booking.tokenAmountUnits &&
            entry.availableDelta == entry.amountUnits &&
            entry.heldDelta == 0 &&
            debit.amountUnits == entry.amountUnits &&
            studentWallet.heldUnits ==
              get(walletPath(booking.studentId)).data.heldUnits -
                entry.amountUnits)) &&
        validLedgerBase(transactionId, entry);
    }

    function validTokenTransactionCreate(transactionId) {
      let entry = request.resource.data;
      return signedIn() &&
        validLedgerBase(transactionId, entry) &&
        (validAdminWalletEntry(transactionId, entry) ||
          validBookingAcceptanceEntry(transactionId, entry) ||
          validBookingDepositHoldEntry(transactionId, entry) ||
          validBookingRefundEntry(transactionId, entry) ||
          validBookingDepositRefundEntry(transactionId, entry) ||
          validBookingSettlementDebit(transactionId, entry) ||
          validBookingSettlementCredit(transactionId, entry));
    }

    function validWalletEntry(uid, transactionId) {
      let entry = getAfter(tokenTransactionPath(transactionId)).data;
      return entry.accountId == uid &&
        entry.actorUid == request.auth.uid &&
        entry.availableDelta ==
          request.resource.data.availableUnits - resource.data.availableUnits &&
        entry.heldDelta ==
          request.resource.data.heldUnits - resource.data.heldUnits &&
        entry.amountUnits is int &&
        entry.amountUnits > 0 &&
        request.resource.data.lastTransactionId == transactionId &&
        request.resource.data.updatedAt == request.time &&
        validWalletShape(request.resource.data);
    }

    function validWalletUpdate(uid) {
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      let transactionId = request.resource.data.get('lastTransactionId', '');
      let entry = getAfter(tokenTransactionPath(transactionId)).data;
      return changes.hasOnly([
          'availableUnits',
          'heldUnits',
          'updatedAt',
          'lastTransactionId'
        ]) &&
        validWalletEntry(uid, transactionId) &&
        ((isAdmin() &&
            entry.type in ['admin_credit', 'admin_debit'] &&
            entry.actorUid == request.auth.uid) ||
          (entry.type == 'booking_acceptance' &&
            uid == entry.accountId &&
            entry.availableDelta == -entry.amountUnits &&
            entry.heldDelta ==
              entry.amountUnits - get(bookingPath(entry.bookingId)).data.tokenDepositUnits) ||
          (entry.type == 'booking_deposit_hold' &&
            uid == entry.accountId &&
            entry.availableDelta == 0 &&
            entry.heldDelta == entry.amountUnits) ||
          (entry.type == 'booking_refund' &&
            uid == entry.accountId &&
            entry.availableDelta == entry.amountUnits &&
            entry.heldDelta <= 0 &&
            (isStudent() || isApprovedTutor(request.auth.uid))) ||
          (entry.type == 'booking_deposit_refund' &&
            uid == entry.accountId &&
            entry.availableDelta == 0 &&
            entry.heldDelta == -entry.amountUnits) ||
          (entry.type == 'booking_settlement_debit' &&
            uid == entry.accountId &&
            entry.availableDelta == 0 &&
            entry.heldDelta == -entry.amountUnits &&
            isApprovedTutor(request.auth.uid)) ||
          (entry.type == 'booking_settlement_credit' &&
            uid == entry.accountId &&
            entry.availableDelta == entry.amountUnits &&
            entry.heldDelta <= 0 &&
            isApprovedTutor(request.auth.uid)));
    }

    function isApprovedTutor(uid) {
      return signedIn() &&
        exists(userPath(uid)) &&
        get(userPath(uid)).data.get('role', '') in ['student', 'tutor', 'professional'] &&
        exists(tutorPath(uid)) &&
        exists(applicationPath(uid)) &&
        get(tutorPath(uid)).data.get('verificationStatus', '') == 'approved' &&
        get(applicationPath(uid)).data.get('verificationStatus', '') == 'approved' &&
        validProfileVersion(get(tutorPath(uid)).data);
    }

    function isTutorApplicationOwner(uid, tutorType) {
      return signedIn() &&
        request.auth.uid == uid &&
        ((isTutor() && isTutorAccountType(tutorType)) ||
          (isStudent() && tutorType in ['peer', 'professional']));
    }

    function isTutorTypeForAccount(uid, tutorType) {
      return (isTutor() && isTutorAccountType(tutorType)) ||
        (isStudent() &&
          exists(applicationPath(uid)) &&
          get(applicationPath(uid)).data.get('tutorType', '') == tutorType);
    }

    function validPublicTutor(data) {
      return data.keys().hasOnly([
          'name',
          'tutorType',
          'tier',
          'credentials',
          'preferredDays',
          'preferredTimeSlots',
          'courseNames',
          'teachingPhilosophy',
          'formats',
          'verificationStatus',
          'verificationNote',
          'publicProfileVersion',
          'createdAt',
          'updatedAt',
          'photoUrl',
          'location',
          'coordinates',
          'availability',
          'online',
          'rating',
          'reviewCount',
          'lastRatingBookingId',
          'totalRecordedTeachingSeconds',
          'lastTeachingBookingId',
          'hourlyRate',
          'bio',
          'subject'
        ]) &&
        data.keys().hasAll([
          'name',
          'tutorType',
          'tier',
          'credentials',
          'preferredDays',
          'preferredTimeSlots',
          'courseNames',
          'teachingPhilosophy',
          'formats',
          'verificationStatus',
          'verificationNote',
          'publicProfileVersion',
          'subject',
          'createdAt',
          'updatedAt'
        ]) &&
        data.name is string &&
        data.tutorType in ['peer', 'professional'] &&
        ((data.tutorType == 'peer' && data.tier == 'Peer Tutor') ||
          (data.tutorType == 'professional' && data.tier in ['Alumni', 'Professor'])) &&
        data.credentials is string &&
        data.preferredDays is list &&
        data.preferredTimeSlots is list &&
        data.courseNames is string &&
        data.courseNames.size() <= 2000 &&
        data.teachingPhilosophy is string &&
        data.formats is list &&
        data.verificationStatus in ['pending', 'approved', 'rejected'] &&
        data.verificationNote is string &&
        validProfileVersion(data) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (!('photoUrl' in data) ||
          data.photoUrl == '' ||
          data.photoUrl.matches('^https://.+')) &&
        (!('hourlyRate' in data) || validTokenPrice(data.hourlyRate)) &&
        (!('rating' in data) ||
          (data.rating is number && data.rating >= 0 && data.rating <= 5)) &&
        (!('reviewCount' in data) ||
          (data.reviewCount is int && data.reviewCount >= 0)) &&
        (!('lastRatingBookingId' in data) ||
          data.lastRatingBookingId is string) &&
        (!('totalRecordedTeachingSeconds' in data) ||
          (data.totalRecordedTeachingSeconds is int &&
            data.totalRecordedTeachingSeconds >= 0)) &&
        (!('lastTeachingBookingId' in data) ||
          data.lastTeachingBookingId is string) &&
        (!('online' in data) || data.online is bool) &&
        data.subject is string &&
        !('courses' in data) &&
        !('applicationProofName' in data) &&
        !('applicationProofUrl' in data) &&
        !('paymentQrUrl' in data);
    }

    function validApplication(data) {
      return data.keys().hasOnly([
          'name',
          'tutorType',
          'tier',
          'credentials',
          'preferredDays',
          'preferredTimeSlots',
          'courses',
          'applicationProofName',
          'applicationProofUrl',
          'teachingPhilosophy',
          'formats',
          'paymentQrUrl',
          'verificationStatus',
          'verificationNote',
          'verificationReviewedBy',
          'verificationReviewedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'name',
          'tutorType',
          'tier',
          'credentials',
          'preferredDays',
          'preferredTimeSlots',
          'courses',
          'teachingPhilosophy',
          'formats',
          'verificationStatus',
          'verificationNote',
          'createdAt',
          'updatedAt'
        ]) &&
        data.name is string &&
        data.tutorType in ['peer', 'professional'] &&
        ((data.tutorType == 'peer' && data.tier == 'Peer Tutor') ||
          (data.tutorType == 'professional' && data.tier in ['Alumni', 'Professor'])) &&
        data.credentials is string &&
        data.preferredDays is list &&
        data.preferredTimeSlots is list &&
        data.courses is list &&
        data.courses.size() > 0 &&
        data.courses.size() <= 30 &&
        data.teachingPhilosophy is string &&
        data.formats is list &&
        data.verificationStatus in ['pending', 'approved', 'rejected'] &&
        data.verificationNote is string &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (!('paymentQrUrl' in data) ||
          data.paymentQrUrl == '' ||
          data.paymentQrUrl.matches('^https://.+')) &&
        (data.tutorType != 'professional' ||
          (data.applicationProofName is string &&
            data.applicationProofUrl is string &&
            data.applicationProofUrl.matches('^https://.+')));
    }

    function validProfileUpdate(uid) {
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      return changes.hasOnly([
          'name',
          'phone',
          'age',
          'location',
          'year',
          'campus',
          'campusAddress',
          'photoUrl',
          'campusId',
          'notificationPreferences',
          'uid'
        ]) &&
        (!('uid' in resource.data) ||
          request.resource.data.get('uid', '') == resource.data.uid) &&
        (!('uid' in request.resource.data) ||
          request.resource.data.uid == uid) &&
        request.resource.data.get('role', '') == resource.data.get('role', '') &&
        request.resource.data.get('tutorType', '') == resource.data.get('tutorType', '') &&
        (!('name' in request.resource.data) ||
          (request.resource.data.name is string && request.resource.data.name.size() <= 120)) &&
        (!('phone' in request.resource.data) ||
          (request.resource.data.phone is string && request.resource.data.phone.size() <= 40)) &&
        (!('age' in request.resource.data) ||
          (request.resource.data.age is string &&
            request.resource.data.age.matches('^[1-9][0-9]{0,2}$'))) &&
        (!('photoUrl' in request.resource.data) ||
          request.resource.data.photoUrl == '' ||
          request.resource.data.photoUrl.matches('^https://.+'));
    }

    function validAccountCreate(uid) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'role',
          'name',
          'campusId',
          'tutorType',
          'tutorVerificationStatus',
          'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'uid',
          'email',
          'role',
          'name',
          'campusId',
          'createdAt'
        ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role in ['student', 'tutor'] &&
        (request.resource.data.role != 'tutor' ||
          (request.resource.data.tutorType in ['peer', 'professional'])) &&
        (request.resource.data.role != 'tutor' ||
          request.resource.data.tutorVerificationStatus == 'pending') &&
        (request.resource.data.role == 'tutor' ||
          (!('tutorType' in request.resource.data) &&
            !('tutorVerificationStatus' in request.resource.data))) &&
        request.resource.data.name is string &&
        request.resource.data.campusId is string &&
        request.resource.data.createdAt == request.time;
    }

    function validAdminTutorAccountReviewSync(uid) {
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin() &&
        request.auth.uid != uid &&
        resource.data.get('role', '') == 'tutor' &&
        resource.data.get('tutorVerificationStatus', '') in
          ['pending', 'approved', 'rejected'] &&
        resource.data.tutorVerificationStatus !=
          request.resource.data.tutorVerificationStatus &&
        exists(applicationPath(uid)) &&
        get(applicationPath(uid)).data.get('verificationStatus', '') == 'pending' &&
        getAfter(applicationPath(uid)).data.verificationStatus ==
          request.resource.data.tutorVerificationStatus &&
        getAfter(tutorPath(uid)).data.verificationStatus ==
          request.resource.data.tutorVerificationStatus &&
        request.resource.data.tutorVerificationStatus in ['approved', 'rejected'] &&
        request.resource.data.tutorVerificationReviewedBy == request.auth.uid &&
        request.resource.data.tutorVerificationReviewedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.tutorVerificationNote is string &&
        (request.resource.data.tutorVerificationStatus != 'rejected' ||
         request.resource.data.tutorVerificationNote.size() > 0) &&
        changes.hasOnly([
         'tutorVerificationStatus',
         'tutorVerificationNote',
         'tutorVerificationReviewedBy',
         'tutorVerificationReviewedAt',
         'updatedAt'
        ]);
    }

    function validTutorApplicationCreate(uid) {
      return isTutorApplicationOwner(uid, request.resource.data.tutorType) &&
        request.resource.data.verificationStatus == 'pending' &&
        !('verificationReviewedBy' in request.resource.data) &&
        !('verificationReviewedAt' in request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        getAfter(tutorPath(uid)).data.verificationStatus == 'pending' &&
        validApplication(request.resource.data);
    }

    function validTutorApplicationUpdate(uid) {
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      return isTutorApplicationOwner(uid, request.resource.data.tutorType) &&
        resource.data.verificationStatus in ['pending', 'rejected'] &&
        request.resource.data.verificationStatus == 'pending' &&
        request.resource.data.verificationNote == '' &&
        !('verificationReviewedBy' in request.resource.data) &&
        !('verificationReviewedAt' in request.resource.data) &&
        changes.hasOnly([
          'name',
          'tutorType',
          'tier',
          'credentials',
          'preferredDays',
          'preferredTimeSlots',
          'courses',
          'applicationProofName',
          'applicationProofUrl',
          'teachingPhilosophy',
          'formats',
          'paymentQrUrl',
          'verificationStatus',
          'verificationNote',
          'verificationReviewedBy',
          'verificationReviewedAt',
          'updatedAt',
          'createdAt'
        ]) &&
        request.resource.data.createdAt ==
          resource.data.get('createdAt', request.time) &&
        request.resource.data.updatedAt == request.time &&
        getAfter(tutorPath(uid)).data.verificationStatus == 'pending' &&
        validApplication(request.resource.data);
    }

    function validTutorPaymentDetailsUpdate(uid) {
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn() &&
        request.auth.uid == uid &&
        isApprovedTutor(uid) &&
        isTutorTypeForAccount(uid, resource.data.tutorType) &&
        request.resource.data.verificationStatus == resource.data.verificationStatus &&
        changes.hasOnly(['paymentQrUrl', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time &&
        (request.resource.data.paymentQrUrl == '' ||
          request.resource.data.paymentQrUrl.matches('^https://.+'));
    }

    function validPublicApplicationCreate(uid) {
      return isTutorApplicationOwner(uid, request.resource.data.tutorType) &&
        request.resource.data.verificationStatus == 'pending' &&
        request.resource.data.publicProfileVersion == 2 &&
        request.resource.data.get('totalRecordedTeachingSeconds', 0) == 0 &&
        request.resource.data.get('lastTeachingBookingId', '') == '' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        getAfter(applicationPath(uid)).data.verificationStatus == 'pending' &&
        validPublicTutor(request.resource.data);
    }

    function validPublicApplicationUpdate(uid) {
      return signedIn() &&
        request.auth.uid == uid &&
        isTutorApplicationOwner(uid, request.resource.data.tutorType) &&
        resource.data.verificationStatus in ['pending', 'rejected'] &&
        request.resource.data.verificationStatus == 'pending' &&
        request.resource.data.verificationNote == '' &&
        request.resource.data.publicProfileVersion == 2 &&
        request.resource.data.createdAt ==
          resource.data.get('createdAt', request.time) &&
        request.resource.data.get('totalRecordedTeachingSeconds', 0) ==
          resource.data.get('totalRecordedTeachingSeconds', 0) &&
        request.resource.data.get('lastTeachingBookingId', '') ==
          resource.data.get('lastTeachingBookingId', '') &&
        request.resource.data.updatedAt == request.time &&
        !('verificationReviewedBy' in request.resource.data) &&
        !('verificationReviewedAt' in request.resource.data) &&
        getAfter(applicationPath(uid)).data.verificationStatus == 'pending' &&
        validPublicTutor(request.resource.data);
    }

    function validTutorBookingDetailsUpdate(uid) {
      let tutor = request.resource.data;
      let application = get(applicationPath(uid)).data;
      return signedIn() &&
        request.auth.uid == uid &&
        exists(applicationPath(uid)) &&
        isTutorTypeForAccount(uid, application.get('tutorType', '')) &&
        application.get('verificationStatus', '') in ['pending', 'approved'] &&
        tutor.get('verificationStatus', '') == application.get('verificationStatus', '') &&
        tutor.get('publicProfileVersion', 0) == 2 &&
        tutor.get('tutorType', '') == application.get('tutorType', '') &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['hourlyRate', 'updatedAt']) &&
        validTutorTokenRate(
          application.get('tutorType', ''),
          tutor.hourlyRate) &&
        request.resource.data.updatedAt == request.time;
    }

    function validTutorRatingAggregate(uid) {
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      let bookingId = request.resource.data.get('lastRatingBookingId', '');
      let bookingBefore = get(bookingPath(bookingId)).data;
      let bookingAfter = getAfter(bookingPath(bookingId)).data;
      let storedCount = resource.data.get('reviewCount', 0);
      let oldCount = storedCount == null ? 0 : storedCount;
      return isStudent() &&
        request.auth.uid == bookingBefore.studentId &&
        bookingBefore.tutorId == uid &&
        bookingBefore.status == 'completed' &&
        !('rating' in bookingBefore) &&
        bookingAfter.status == 'completed' &&
        bookingAfter.rating is int &&
        bookingAfter.rating >= 0 &&
        bookingAfter.rating <= 5 &&
        bookingAfter.review is string &&
        bookingAfter.review.size() <= 1000 &&
        bookingAfter.ratingIsAnonymous is bool &&
        bookingAfter.ratingAuthor is string &&
        (bookingAfter.ratingIsAnonymous
          ? bookingAfter.ratingAuthor == 'Anonymous'
          : bookingAfter.ratingAuthor == bookingBefore.studentName) &&
        bookingAfter.ratingCreatedAt == request.time &&
        bookingAfter.updatedAt == request.time &&
        oldCount is int &&
        oldCount >= 0 &&
        request.resource.data.reviewCount == oldCount + 1 &&
        (oldCount == 0
          ? request.resource.data.rating == bookingAfter.rating
          : (resource.data.rating is number &&
              request.resource.data.rating ==
                ((resource.data.rating * oldCount + bookingAfter.rating) /
                  (oldCount + 1)))) &&
        request.resource.data.lastRatingBookingId == bookingId &&
        request.resource.data.updatedAt == request.time &&
        changes.hasOnly([
          'rating',
          'reviewCount',
          'lastRatingBookingId',
          'updatedAt'
        ]);
    }

    function validTutorTeachingHoursAggregate(uid) {
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      let bookingId = request.resource.data.get('lastTeachingBookingId', '');
      let bookingBefore = get(bookingPath(bookingId)).data;
      let bookingAfter = getAfter(bookingPath(bookingId)).data;
      let oldSeconds = resource.data.get('totalRecordedTeachingSeconds', 0);
      return isApprovedTutor(uid) &&
        request.auth.uid == uid &&
        bookingBefore.tutorId == uid &&
        bookingBefore.status == 'upcoming' &&
        bookingBefore.get('timerStatus', '') == 'stopped' &&
        bookingBefore.get('accumulatedDurationSeconds', 0) is int &&
        bookingBefore.get('accumulatedDurationSeconds', 0) > 0 &&
        bookingAfter.status == 'completed' &&
        oldSeconds is int &&
        oldSeconds >= 0 &&
        request.resource.data.totalRecordedTeachingSeconds ==
          oldSeconds + bookingBefore.accumulatedDurationSeconds &&
        request.resource.data.lastTeachingBookingId == bookingId &&
        request.resource.data.updatedAt == request.time &&
        changes.hasOnly([
          'totalRecordedTeachingSeconds',
          'lastTeachingBookingId',
          'updatedAt'
        ]);
    }

    function validTutorCompletedBookingsAggregate(uid) {
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      let bookingId = request.resource.data.get('lastTutorCompletedBookingId', '');
      let bookingBefore = get(bookingPath(bookingId)).data;
      let bookingAfter = getAfter(bookingPath(bookingId)).data;
      let oldCount = resource.data.get('tutorCompletedBookingCount', 0);
      return isApprovedTutor(uid) &&
        request.auth.uid == uid &&
        bookingBefore.tutorId == uid &&
        bookingBefore.status == 'upcoming' &&
        bookingBefore.get('timerStatus', '') == 'stopped' &&
        bookingBefore.get('accumulatedDurationSeconds', 0) is int &&
        bookingBefore.get('accumulatedDurationSeconds', 0) > 0 &&
        bookingAfter.status == 'completed' &&
        oldCount is int &&
        oldCount >= 0 &&
        request.resource.data.tutorCompletedBookingCount == oldCount + 1 &&
        request.resource.data.lastTutorCompletedBookingId == bookingId &&
        changes.hasOnly([
          'tutorCompletedBookingCount',
          'lastTutorCompletedBookingId'
        ]);
    }

    function validStudentBadgeAwardCreate(bookingId, awardId) {
      let booking = get(bookingPath(bookingId)).data;
      let data = request.resource.data;
      return signedIn() &&
        awardId == 'award' &&
        isApprovedTutor(request.auth.uid) &&
        booking.tutorId == request.auth.uid &&
        booking.status == 'completed' &&
        data.keys().hasOnly([
          'badgeId',
          'bookingId',
          'tutorId',
          'studentId',
          'note',
          'createdAt'
        ]) &&
        data.keys().hasAll([
          'badgeId',
          'bookingId',
          'tutorId',
          'studentId',
          'createdAt'
        ]) &&
        data.badgeId in [
          'curious_mind',
          'prepared_learner',
          'persistent_effort',
          'big_step',
          'clear_communicator',
          'great_collaborator',
          'creative_thinker',
          'practice_pro',
          'goal_getter',
          'brave_beginner',
          'thoughtful_reflector',
          'kind_and_respectful'
        ] &&
        data.bookingId == bookingId &&
        data.tutorId == request.auth.uid &&
        data.studentId == booking.studentId &&
        data.createdAt == request.time &&
        (!('note' in data) ||
          (data.note is string && data.note.size() <= 280));
    }

    function validTutorAchievementCreate(achievementId) {
      let badgeId = request.resource.data.get('badgeId', '');
      let tutorId = request.resource.data.get('tutorId', '');
      let bookingId = request.resource.data.get('qualifyingBookingId', '');
      let userBefore = get(userPath(tutorId)).data;
      let userAfter = getAfter(userPath(tutorId)).data;
      let tutorAfter = getAfter(tutorPath(tutorId)).data;
      let oldCount = userBefore.get('tutorCompletedBookingCount', 0);
      let newCount = userAfter.get('tutorCompletedBookingCount', 0);
      let newSeconds = tutorAfter.get('totalRecordedTeachingSeconds', 0);
      return signedIn() &&
        request.auth.uid == tutorId &&
        isApprovedTutor(tutorId) &&
        achievementId == tutorId + '_' + badgeId &&
        badgeId in [
          'first_lesson',
          'steady_mentor',
          'experienced_guide',
          'hours_of_impact'
        ] &&
        request.resource.data.keys().hasOnly([
          'badgeId',
          'tutorId',
          'qualifyingBookingId',
          'criterionVersion',
          'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'badgeId',
          'tutorId',
          'qualifyingBookingId',
          'criterionVersion',
          'createdAt'
        ]) &&
        request.resource.data.criterionVersion == 1 &&
        request.resource.data.createdAt == request.time &&
        get(bookingPath(bookingId)).data.tutorId == tutorId &&
        get(bookingPath(bookingId)).data.status == 'upcoming' &&
        get(bookingPath(bookingId)).data.get('timerStatus', '') == 'stopped' &&
        get(bookingPath(bookingId)).data.get('accumulatedDurationSeconds', 0) is int &&
        get(bookingPath(bookingId)).data.get('accumulatedDurationSeconds', 0) > 0 &&
        getAfter(bookingPath(bookingId)).data.status == 'completed' &&
        userAfter.lastTutorCompletedBookingId == bookingId &&
        tutorAfter.lastTeachingBookingId == bookingId &&
        ((badgeId == 'first_lesson' &&
            oldCount < 1 && newCount >= 1) ||
          (badgeId == 'steady_mentor' &&
            oldCount < 10 && newCount >= 10) ||
          (badgeId == 'experienced_guide' &&
            oldCount < 25 && newCount >= 25) ||
          (badgeId == 'hours_of_impact' &&
            newSeconds >= 36000));
    }

    function validStudentBadgeVisibility(uid, bookingId) {
      let award = get(studentBadgeAwardPath(bookingId)).data;
      let data = request.resource.data;
      return signedIn() &&
        request.auth.uid == uid &&
        award.studentId == uid &&
        data.keys().hasOnly(['visible', 'updatedAt']) &&
        data.keys().hasAll(['visible', 'updatedAt']) &&
        data.visible is bool &&
        data.updatedAt == request.time;
    }

    function validTutorAchievementVisibility(uid, badgeId) {
      let achievementPath = tutorAchievementPath(uid, badgeId);
      let data = request.resource.data;
      return signedIn() &&
        request.auth.uid == uid &&
        badgeId in [
          'first_lesson',
          'steady_mentor',
          'experienced_guide',
          'hours_of_impact'
        ] &&
        exists(achievementPath) &&
        get(achievementPath).data.tutorId == uid &&
        data.keys().hasOnly(['visible', 'updatedAt']) &&
        data.keys().hasAll(['visible', 'updatedAt']) &&
        data.visible is bool &&
        data.updatedAt == request.time;
    }

    function milestoneRecordMatches(bookingId, tutorId, badgeId) {
      let path = tutorAchievementPath(tutorId, badgeId);
      return existsAfter(path) &&
        getAfter(path).data.qualifyingBookingId == bookingId;
    }

    function validAdminTutorReview(uid) {
      return isAdmin() &&
        request.auth.uid != uid &&
        request.resource.data.verificationStatus in ['approved', 'rejected'] &&
        request.resource.data.updatedAt == request.time &&
        getAfter(applicationPath(uid)).data.verificationReviewedBy == request.auth.uid &&
        getAfter(applicationPath(uid)).data.verificationReviewedAt == request.time &&
        getAfter(applicationPath(uid)).data.verificationStatus ==
          request.resource.data.verificationStatus &&
        validPublicTutor(request.resource.data);
    }

    function validAdminApplicationCreate(uid) {
      return isAdmin() &&
        request.auth.uid != uid &&
        exists(userPath(uid)) &&
        get(userPath(uid)).data.get('role', '') in ['student', 'tutor', 'professional'] &&
        request.resource.data.verificationStatus in ['approved', 'rejected'] &&
        request.resource.data.verificationReviewedBy == request.auth.uid &&
        request.resource.data.verificationReviewedAt == request.time &&
        getAfter(tutorPath(uid)).data.verificationStatus ==
          request.resource.data.verificationStatus &&
        validApplication(request.resource.data);
    }

    function validAdminApplicationUpdate(uid) {
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin() &&
        request.auth.uid != uid &&
        resource.data.verificationStatus == 'pending' &&
        request.resource.data.verificationStatus in ['approved', 'rejected'] &&
        request.resource.data.verificationReviewedBy == request.auth.uid &&
        request.resource.data.verificationReviewedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        getAfter(tutorPath(uid)).data.verificationStatus ==
          request.resource.data.verificationStatus &&
        changes.hasOnly([
          'verificationStatus',
          'verificationNote',
          'verificationReviewedBy',
          'verificationReviewedAt',
          'updatedAt'
        ]);
    }

    function validBookingTokenSplit(booking) {
      return booking.tokenAmountUnits is int &&
        booking.tokenAmountUnits >= 5 &&
        booking.tokenDepositUnits is int &&
        booking.tokenDepositUnits > 0 &&
        booking.tokenDepositUnits < booking.tokenAmountUnits &&
        booking.tokenDepositUnits * 5 >= booking.tokenAmountUnits - 2 &&
        booking.tokenDepositUnits * 5 <= booking.tokenAmountUnits + 2;
    }

    function validBookingAcceptanceApplied(bookingId, booking) {
      let studentBefore = get(walletPath(booking.studentId)).data;
      let studentAfter = getAfter(walletPath(booking.studentId)).data;
      let tutorBefore = get(walletPath(booking.tutorId)).data;
      let tutorAfter = getAfter(walletPath(booking.tutorId)).data;
      let acceptance = getAfter(tokenTransactionPath(
        bookingId + '_acceptance'
      )).data;
      let depositHold = getAfter(tokenTransactionPath(
        bookingId + '_deposit_hold'
      )).data;
      let remainingUnits = booking.tokenAmountUnits - booking.tokenDepositUnits;
      return validBookingTokenSplit(booking) &&
        booking.tokenStatus == 'reserved' &&
        studentAfter.availableUnits ==
          studentBefore.availableUnits - booking.tokenAmountUnits &&
        studentAfter.heldUnits ==
          studentBefore.heldUnits + remainingUnits &&
        studentAfter.lastTransactionId == bookingId + '_acceptance' &&
        tutorAfter.availableUnits == tutorBefore.availableUnits &&
        tutorAfter.heldUnits == tutorBefore.heldUnits + booking.tokenDepositUnits &&
        tutorAfter.lastTransactionId == bookingId + '_deposit_hold' &&
        acceptance.type == 'booking_acceptance' &&
        acceptance.bookingId == bookingId &&
        acceptance.accountId == booking.studentId &&
        acceptance.amountUnits == booking.tokenAmountUnits &&
        acceptance.availableDelta == -booking.tokenAmountUnits &&
        acceptance.heldDelta == remainingUnits &&
        acceptance.actorUid == booking.tutorId &&
        depositHold.type == 'booking_deposit_hold' &&
        depositHold.bookingId == bookingId &&
        depositHold.accountId == booking.tutorId &&
        depositHold.amountUnits == booking.tokenDepositUnits &&
        depositHold.availableDelta == 0 &&
        depositHold.heldDelta == booking.tokenDepositUnits &&
        depositHold.actorUid == booking.tutorId;
    }

    function validBookingRefundApplied(bookingId, booking) {
      let walletBefore = get(walletPath(booking.studentId)).data;
      let walletAfter = getAfter(walletPath(booking.studentId)).data;
      let entry = getAfter(tokenTransactionPath(bookingId + '_refund')).data;
      return booking.tokenStatus == 'refunded' &&
        entry.type == 'booking_refund' &&
        entry.bookingId == bookingId &&
        entry.accountId == booking.studentId &&
        entry.amountUnits == booking.tokenAmountUnits &&
        entry.availableDelta == booking.tokenAmountUnits &&
        (entry.actorUid == booking.studentId ||
          entry.actorUid == booking.tutorId) &&
        walletAfter.availableUnits ==
          walletBefore.availableUnits + booking.tokenAmountUnits &&
        walletAfter.lastTransactionId == bookingId + '_refund' &&
        (('tokenDepositUnits' in booking)
          ? (validBookingTokenSplit(booking) &&
              booking.status == 'cancelled' &&
              entry.heldDelta ==
                -(booking.tokenAmountUnits - booking.tokenDepositUnits) &&
              walletAfter.heldUnits ==
                walletBefore.heldUnits -
                  (booking.tokenAmountUnits - booking.tokenDepositUnits) &&
              getAfter(tokenTransactionPath(
                bookingId + '_deposit_refund'
              )).data.type == 'booking_deposit_refund')
          : (entry.heldDelta == -booking.tokenAmountUnits &&
              walletAfter.heldUnits ==
                walletBefore.heldUnits - booking.tokenAmountUnits));
    }

    function validBookingSettlementApplied(bookingId, booking) {
      let studentBefore = get(walletPath(booking.studentId)).data;
      let studentAfter = getAfter(walletPath(booking.studentId)).data;
      let tutorBefore = get(walletPath(booking.tutorId)).data;
      let tutorAfter = getAfter(walletPath(booking.tutorId)).data;
      let debit = getAfter(tokenTransactionPath(
        bookingId + '_settlement_debit'
      )).data;
      let credit = getAfter(tokenTransactionPath(
        bookingId + '_settlement_credit'
      )).data;
      return booking.tokenStatus == 'settled' &&
        debit.type == 'booking_settlement_debit' &&
        debit.bookingId == bookingId &&
        debit.accountId == booking.studentId &&
        debit.actorUid == booking.tutorId &&
        debit.availableDelta == 0 &&
        credit.type == 'booking_settlement_credit' &&
        credit.bookingId == bookingId &&
        credit.accountId == booking.tutorId &&
        credit.actorUid == booking.tutorId &&
        credit.availableDelta == booking.tokenAmountUnits &&
        studentAfter.availableUnits == studentBefore.availableUnits &&
        studentAfter.lastTransactionId == bookingId + '_settlement_debit' &&
        tutorAfter.availableUnits ==
          tutorBefore.availableUnits + booking.tokenAmountUnits &&
        tutorAfter.lastTransactionId == bookingId + '_settlement_credit' &&
        (('tokenDepositUnits' in booking)
          ? (validBookingTokenSplit(booking) &&
              debit.amountUnits ==
                booking.tokenAmountUnits - booking.tokenDepositUnits &&
              debit.heldDelta ==
                -(booking.tokenAmountUnits - booking.tokenDepositUnits) &&
              credit.amountUnits == booking.tokenAmountUnits &&
              credit.heldDelta == -booking.tokenDepositUnits &&
              studentAfter.heldUnits ==
                studentBefore.heldUnits -
                  (booking.tokenAmountUnits - booking.tokenDepositUnits) &&
              tutorAfter.heldUnits ==
                tutorBefore.heldUnits - booking.tokenDepositUnits)
          : (debit.amountUnits == booking.tokenAmountUnits &&
              debit.heldDelta == -booking.tokenAmountUnits &&
              credit.amountUnits == booking.tokenAmountUnits &&
              credit.heldDelta == 0 &&
              studentAfter.heldUnits ==
                studentBefore.heldUnits - booking.tokenAmountUnits &&
              tutorAfter.heldUnits == tutorBefore.heldUnits));
    }

    function validBookingCreate() {
      let data = request.resource.data;
      let publicTutor = get(tutorPath(data.tutorId)).data;
      let student = get(userPath(request.auth.uid)).data;
      let expectedStudentName = student.get('name', '') == ''
        ? student.get('email', 'Student')
        : student.get('name', '');
      return isStudent() &&
        data.studentId == request.auth.uid &&
        exists(tutorPath(data.tutorId)) &&
        isApprovedTutor(data.tutorId) &&
        publicTutor.verificationStatus == 'approved' &&
        validProfileVersion(publicTutor) &&
        validTutorTokenRate(publicTutor.get('tutorType', ''), publicTutor.hourlyRate) &&
        data.totalAmount == publicTutor.hourlyRate &&
        data.studentName == expectedStudentName &&
        data.tutorName == publicTutor.name &&
        data.tutorTier == publicTutor.tier &&
        data.subject == publicTutor.subject &&
        data.keys().hasOnly([
          'studentId',
          'tutorId',
          'studentName',
          'tutorName',
          'tutorTier',
          'subject',
          'dateKey',
          'startTime',
          'endTime',
          'durationHours',
          'location',
          'sessionMode',
          'notes',
          'totalAmount',
          'tokenAmountUnits',
          'tokenDepositUnits',
          'tokenStatus',
          'tutorPhotoUrl',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'studentId',
          'tutorId',
          'studentName',
          'tutorName',
          'tutorTier',
          'subject',
          'dateKey',
          'startTime',
          'endTime',
          'durationHours',
          'location',
          'sessionMode',
          'notes',
          'totalAmount',
          'tokenAmountUnits',
          'tokenDepositUnits',
          'tokenStatus',
          'tutorPhotoUrl',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.status == 'requested' &&
        data.tokenStatus == 'pending' &&
        data.totalAmount is number &&
        data.totalAmount > 0 &&
        tokenPriceMatchesUnits(data.totalAmount, data.tokenAmountUnits) &&
        exists(walletPath(request.auth.uid)) &&
        get(walletPath(request.auth.uid)).data.get('availableUnits', -1) >=
          data.tokenAmountUnits &&
        validBookingTokenSplit(data) &&
        data.durationHours is number &&
        data.durationHours > 0 &&
        data.durationHours <= 8 &&
        data.dateKey is string &&
        data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.startTime is string &&
        data.endTime is string &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function isBookingStudent() {
      return isStudent() && resource.data.studentId == request.auth.uid;
    }

    function isBookingTutor() {
      return isApprovedTutor(request.auth.uid) &&
        resource.data.tutorId == request.auth.uid;
    }

    function validTutorResponse(bookingId) {
      let data = request.resource.data;
      let changes = data.diff(resource.data).affectedKeys();
      let tokenBooking = 'tokenStatus' in resource.data;
      return isBookingTutor() &&
        resource.data.status == 'requested' &&
        data.status in ['upcoming', 'rejected'] &&
        data.updatedAt == request.time &&
        (tokenBooking
          ? (changes.hasOnly(['status', 'tokenStatus', 'updatedAt']) &&
              (resource.data.tokenStatus == 'pending'
                ? ((data.status == 'upcoming' &&
                    data.tokenStatus == 'reserved' &&
                    validBookingAcceptanceApplied(bookingId, data)) ||
                  (data.status == 'rejected' &&
                      data.tokenStatus == 'not_charged'))
                : ((data.status == 'upcoming' &&
                    data.tokenStatus == 'reserved' &&
                    resource.data.tokenStatus == 'reserved') ||
                  (data.status == 'rejected' &&
                    data.tokenStatus == 'refunded' &&
                    validBookingRefundApplied(bookingId, data)))))
          : (changes.hasOnly([
                'status',
                'paymentStatus',
                'tutorPhotoUrl',
                'updatedAt'
              ]) &&
              ((data.status == 'upcoming' &&
                  data.paymentStatus == 'awaiting_payment') ||
                (data.status == 'rejected' &&
                  data.paymentStatus == 'not_applicable'))));
    }

    function validBookingCancellation(bookingId) {
      let data = request.resource.data;
      let tokenBooking = 'tokenStatus' in resource.data;
      return (isBookingStudent() || isBookingTutor()) &&
        resource.data.status in ['requested', 'upcoming'] &&
        data.status == 'cancelled' &&
        data.updatedAt == request.time &&
        (tokenBooking
          ? (data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'tokenStatus', 'cancelledBy', 'updatedAt']) &&
              data.cancelledBy == request.auth.uid &&
              (resource.data.tokenStatus == 'pending'
                ? data.tokenStatus == 'not_charged'
                : (data.tokenStatus == 'refunded' &&
                    validBookingRefundApplied(bookingId, data))))
          : (!(resource.data.paymentStatus in ['pending_verification', 'settled']) &&
              data.paymentStatus == 'not_applicable' &&
              data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'paymentStatus', 'cancelledBy', 'updatedAt']) &&
              data.cancelledBy == request.auth.uid));
    }

    function bookingCancellationNotificationFromCaller(data) {
      let bookingId = data.data.get('bookingId', 'invalid');
      let booking = get(bookingPath(bookingId)).data;
      return signedIn() &&
        data.type == 'booking_cancelled' &&
        data.keys().hasOnly([
          'recipientId', 'type', 'title', 'message', 'data', 'read', 'createdAt'
        ]) &&
        data.data.keys().hasOnly(['bookingId', 'cancelledBy']) &&
        data.data.cancelledBy == request.auth.uid &&
        booking.status == 'cancelled' &&
        booking.cancelledBy == request.auth.uid &&
        request.auth.uid in [booking.studentId, booking.tutorId] &&
        data.recipientId in [booking.studentId, booking.tutorId] &&
        data.recipientId != request.auth.uid &&
        data.title == 'Session cancelled' &&
        data.message is string &&
        data.message.size() > 0 &&
        data.message.size() <= 1000;
    }

    function validBookingCancellationNotification(data) {
      return bookingCancellationNotificationFromCaller(data) &&
        data.read == false &&
        data.createdAt == request.time;
    }

    function validBookingTimerUpdate() {
      let data = request.resource.data;
      let changes = data.diff(resource.data).affectedKeys();
      let oldStatus = resource.data.get('timerStatus', 'idle');
      let newStatus = data.get('timerStatus', '');
      let action = data.get('timerLastAction', '');
      return isBookingTutor() &&
        resource.data.status == 'upcoming' &&
        data.status == resource.data.status &&
        data.get('tokenStatus', '') == resource.data.get('tokenStatus', '') &&
        data.updatedAt == request.time &&
        data.timerLastActionAt == request.time &&
        action in ['start', 'pause', 'resume', 'stop'] &&
        newStatus in ['running', 'paused', 'stopped'] &&
        data.accumulatedDurationSeconds is int &&
        data.accumulatedDurationSeconds >= resource.data.get('accumulatedDurationSeconds', 0) &&
        (oldStatus != 'running' ||
          (resource.data.timerStartedAt is timestamp &&
            resource.data.timerStartedAt + duration.value(
              data.accumulatedDurationSeconds - resource.data.get('accumulatedDurationSeconds', 0),
              's'
            ) <= request.time)) &&
        data.timerActionHistory is list &&
        data.timerActionHistory.size() <= 50 &&
        changes.hasOnly([
          'timerStatus',
          'accumulatedDurationSeconds',
          'timerStartedAt',
          'timerPausedAt',
          'timerStoppedAt',
          'timerLastAction',
          'timerLastActionAt',
          'timerActionHistory',
          'updatedAt'
        ]) &&
        ((oldStatus == 'idle' && action == 'start' && newStatus == 'running') ||
          (oldStatus == 'running' && action == 'pause' && newStatus == 'paused') ||
          (oldStatus == 'paused' && action == 'resume' && newStatus == 'running') ||
          (oldStatus in ['running', 'paused'] && action == 'stop' && newStatus == 'stopped')) &&
        ((newStatus == 'running' && data.timerStartedAt == request.time) ||
          (newStatus == 'paused' && data.timerPausedAt == request.time) ||
          (newStatus == 'stopped' && data.timerStoppedAt == request.time));
    }

    function validBookingCompletion(bookingId) {
      let data = request.resource.data;
      let tokenBooking = 'tokenStatus' in resource.data;
      let tutorBefore = get(tutorPath(resource.data.tutorId)).data;
      let tutorAfter = getAfter(tutorPath(resource.data.tutorId)).data;
      let userBefore = get(userPath(resource.data.tutorId)).data;
      let userAfter = getAfter(userPath(resource.data.tutorId)).data;
      let oldSeconds = tutorBefore.get('totalRecordedTeachingSeconds', 0);
      let oldCount = userBefore.get('tutorCompletedBookingCount', 0);
      return isBookingTutor() &&
        resource.data.status == 'upcoming' &&
        resource.data.get('timerStatus', '') == 'stopped' &&
        resource.data.get('accumulatedDurationSeconds', 0) is int &&
        resource.data.get('accumulatedDurationSeconds', 0) > 0 &&
        data.status == 'completed' &&
        data.updatedAt == request.time &&
        oldSeconds is int &&
        oldSeconds >= 0 &&
        tutorAfter.totalRecordedTeachingSeconds ==
          oldSeconds + resource.data.accumulatedDurationSeconds &&
        tutorAfter.lastTeachingBookingId == bookingId &&
        tutorAfter.updatedAt == request.time &&
        oldCount is int &&
        oldCount >= 0 &&
        userAfter.tutorCompletedBookingCount == oldCount + 1 &&
        userAfter.lastTutorCompletedBookingId == bookingId &&
        ((oldCount >= 1) ||
          milestoneRecordMatches(bookingId, resource.data.tutorId, 'first_lesson')) &&
        ((oldCount >= 10) ||
          userAfter.tutorCompletedBookingCount < 10 ||
          milestoneRecordMatches(bookingId, resource.data.tutorId, 'steady_mentor')) &&
        ((oldCount >= 25) ||
          userAfter.tutorCompletedBookingCount < 25 ||
          milestoneRecordMatches(bookingId, resource.data.tutorId, 'experienced_guide')) &&
        ((tutorAfter.totalRecordedTeachingSeconds < 36000) ||
          exists(tutorAchievementPath(resource.data.tutorId, 'hours_of_impact')) ||
          milestoneRecordMatches(bookingId, resource.data.tutorId, 'hours_of_impact')) &&
        (tokenBooking
          ? (data.tokenStatus == 'settled' &&
              data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'tokenStatus', 'updatedAt']) &&
              validBookingSettlementApplied(bookingId, data))
          : (data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt'])));
    }

    function validStudentBookingRating(bookingId) {
      let data = request.resource.data;
      let changes = data.diff(resource.data).affectedKeys();
      let tutorBefore = get(tutorPath(resource.data.tutorId)).data;
      let tutorAfter = getAfter(tutorPath(resource.data.tutorId)).data;
      let storedCount = tutorBefore.get('reviewCount', 0);
      let oldCount = storedCount == null ? 0 : storedCount;
      return isBookingStudent() &&
        resource.data.status == 'completed' &&
        !('rating' in resource.data) &&
        data.status == 'completed' &&
        data.rating is int &&
        data.rating >= 0 &&
        data.rating <= 5 &&
        data.review is string &&
        data.review.size() <= 1000 &&
        data.ratingIsAnonymous is bool &&
        data.ratingAuthor is string &&
        (data.ratingIsAnonymous
          ? data.ratingAuthor == 'Anonymous'
          : data.ratingAuthor == resource.data.studentName) &&
        data.ratingCreatedAt == request.time &&
        data.updatedAt == request.time &&
        oldCount is int &&
        oldCount >= 0 &&
        tutorAfter.lastRatingBookingId == bookingId &&
        tutorAfter.reviewCount == oldCount + 1 &&
        (oldCount == 0
          ? tutorAfter.rating == data.rating
          : (tutorBefore.rating is number &&
              tutorAfter.rating ==
                ((tutorBefore.rating * oldCount + data.rating) /
                  (oldCount + 1)))) &&
        tutorAfter.updatedAt == request.time &&
        changes.hasOnly([
          'rating',
          'review',
          'ratingIsAnonymous',
          'ratingAuthor',
          'ratingCreatedAt',
          'updatedAt'
        ]);
    }

    function validPaymentReport() {
      let data = request.resource.data;
      return isBookingStudent() &&
        !('tokenStatus' in resource.data) &&
        resource.data.status == 'upcoming' &&
        resource.data.paymentStatus == 'awaiting_payment' &&
        data.paymentStatus == 'pending_verification' &&
        data.paymentReportedAt == request.time &&
        data.diff(resource.data).affectedKeys()
          .hasOnly(['paymentStatus', 'paymentReportedAt', 'updatedAt']) &&
        data.updatedAt == request.time;
    }

    function validPaymentVerification() {
      let data = request.resource.data;
      return isBookingTutor() &&
        !('tokenStatus' in resource.data) &&
        resource.data.status in ['upcoming', 'completed'] &&
        resource.data.paymentStatus == 'pending_verification' &&
        data.paymentStatus == 'settled' &&
        data.paymentVerifiedAt == request.time &&
        data.diff(resource.data).affectedKeys()
          .hasOnly(['paymentStatus', 'paymentVerifiedAt', 'updatedAt']) &&
        data.updatedAt == request.time;
    }

    function validReschedule() {
      let data = request.resource.data;
      return isBookingStudent() &&
        resource.data.status == 'upcoming' &&
        (('tokenStatus' in resource.data &&
            resource.data.tokenStatus == 'reserved') ||
          (!('tokenStatus' in resource.data) &&
            resource.data.paymentStatus == 'awaiting_payment')) &&
        data.dateKey is string &&
        data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.startTime is string &&
        data.endTime is string &&
        data.durationHours is number &&
        data.durationHours > 0 &&
        data.durationHours <= 8 &&
        data.diff(resource.data).affectedKeys()
          .hasOnly(['dateKey', 'startTime', 'endTime', 'durationHours', 'updatedAt']) &&
        data.updatedAt == request.time;
    }

    function validCheckIn() {
      let data = request.resource.data;
      let coordinates = data.checkInCoordinates;
      return isBookingStudent() &&
        resource.data.status == 'upcoming' &&
        !('checkedInAt' in resource.data) &&
        data.checkedInAt == request.time &&
        coordinates is map &&
        coordinates.keys().hasOnly(['latitude', 'longitude']) &&
        coordinates.keys().hasAll(['latitude', 'longitude']) &&
        coordinates.latitude is number &&
        coordinates.longitude is number &&
        coordinates.latitude >= -90 &&
        coordinates.latitude <= 90 &&
        coordinates.longitude >= -180 &&
        coordinates.longitude <= 180 &&
        data.diff(resource.data).affectedKeys()
          .hasOnly(['checkedInAt', 'checkInCoordinates', 'updatedAt']) &&
        data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() &&
        request.auth.uid == uid &&
        validAccountCreate(uid);
      allow update: if validAdminTutorAccountReviewSync(uid) ||
        validTutorCompletedBookingsAggregate(uid) ||
        (signedIn() &&
          request.auth.uid == uid &&
          validProfileUpdate(uid));
      allow delete: if false;

      match /studentBadgeVisibility/{bookingId} {
        allow get, list: if signedIn() && request.auth.uid == uid;
        allow create, update: if validStudentBadgeVisibility(uid, bookingId);
        allow delete: if false;
      }

      match /tutorAchievementVisibility/{badgeId} {
        allow get, list: if signedIn() && request.auth.uid == uid;
        allow create, update: if validTutorAchievementVisibility(uid, badgeId);
        allow delete: if false;
      }
    }

    match /tutors/{uid} {
      allow get: if isAdmin() ||
        (signedIn() && request.auth.uid == uid) ||
        ((isStudent() || isTutor()) &&
          resource.data.get('verificationStatus', '') == 'approved' &&
          validProfileVersion(resource.data));
      allow list: if isAdmin() ||
        ((isStudent() || isTutor()) &&
          resource.data.get('verificationStatus', '') == 'approved' &&
          validProfileVersion(resource.data));
      allow create: if validPublicApplicationCreate(uid);
      allow update: if validAdminTutorReview(uid) ||
        validPublicApplicationUpdate(uid) ||
        validTutorBookingDetailsUpdate(uid) ||
        validTutorRatingAggregate(uid) ||
        validTutorTeachingHoursAggregate(uid);
      allow delete: if false;
    }

    match /tutorApplications/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if validTutorApplicationCreate(uid) ||
        validAdminApplicationCreate(uid);
      allow update: if validTutorApplicationUpdate(uid) ||
        validTutorPaymentDetailsUpdate(uid) ||
        validAdminApplicationUpdate(uid);
      allow delete: if false;
    }

    match /wallets/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if validWalletInitialization(uid);
      allow update: if validWalletUpdate(uid);
      allow delete: if false;
    }

    match /tokenTransactions/{transactionId} {
      allow get, list: if isAdmin() ||
        (signedIn() && resource.data.accountId == request.auth.uid);
      allow create: if validTokenTransactionCreate(transactionId);
      allow update, delete: if false;
    }

    match /tutorAchievements/{achievementId} {
      allow get: if signedIn() &&
        (!exists(tutorAchievementDocumentPath(achievementId)) ||
          resource.data.tutorId == request.auth.uid);
      allow list: if signedIn() && resource.data.tutorId == request.auth.uid;
      allow create: if validTutorAchievementCreate(achievementId);
      allow update, delete: if false;
    }

    match /bookings/{bookingId} {
      allow get, list: if isAdmin() ||
        (isBookingStudent()) ||
        (isBookingTutor());
      allow create: if validBookingCreate();
      allow update: if validTutorResponse(bookingId) ||
        validBookingCancellation(bookingId) ||
        validBookingTimerUpdate() ||
        validBookingCompletion(bookingId) ||
        validPaymentReport() ||
        validPaymentVerification() ||
        validReschedule() ||
        validCheckIn() ||
        validStudentBookingRating(bookingId);
      allow delete: if false;

      match /badgeAwards/{awardId} {
        allow get: if signedIn() &&
          (!exists(studentBadgeAwardPath(bookingId))
            ? (get(bookingPath(bookingId)).data.studentId == request.auth.uid ||
                get(bookingPath(bookingId)).data.tutorId == request.auth.uid)
            : (resource.data.studentId == request.auth.uid ||
                resource.data.tutorId == request.auth.uid));
        allow create: if validStudentBadgeAwardCreate(bookingId, awardId);
        allow update, delete: if false;
      }
    }

    match /{path=**}/badgeAwards/{awardId} {
      allow get: if signedIn() &&
        (resource.data.studentId == request.auth.uid ||
          resource.data.tutorId == request.auth.uid);
      allow list: if signedIn() &&
        (resource.data.studentId == request.auth.uid ||
          resource.data.tutorId == request.auth.uid);
    }

    // Chat remains closed in the main application rules until its ownership
    // rules are deployed. Booking cancellation alerts are recipient-scoped.
    match /conversations/{conversationId} {
      allow read, write: if false;

      match /messages/{messageId} {
        allow read, write: if false;
      }
    }

    match /notifications/{notificationId} {
      allow get: if signedIn() &&
        (!exists(/databases/$(database)/documents/notifications/$(notificationId)) ||
          resource.data.recipientId == request.auth.uid ||
          bookingCancellationNotificationFromCaller(resource.data));
      allow list: if signedIn() &&
        resource.data.recipientId == request.auth.uid;
      allow create: if validBookingCancellationNotification(request.resource.data);
      allow update: if signedIn() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.read == true;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
