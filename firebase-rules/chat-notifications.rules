rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function conversation(id) { return get(/databases/$(database)/documents/conversations/$(id)).data; }
    function participant(id) { return signedIn() && request.auth.uid in conversation(id).participantIds; }
    function sentNotification(data) {
      return signedIn() && data.type == 'new_message'
        && data.data.conversationId is string && data.data.messageId is string
        && get(/databases/$(database)/documents/conversations/$(data.data.conversationId)/messages/$(data.data.messageId)).data.senderId == request.auth.uid;
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Account provisioning and profile updates remain under Member 1's rules.
    }
    match /tutors/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || resource.data.verificationStatus == 'approved');
    }
    match /conversations/{id} {
      // Reading a missing deterministic ID is needed by get-or-create's transaction.
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/conversations/$(id)) || request.auth.uid in resource.data.participantIds);
      allow list: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['studentId', 'tutorId', 'participantIds', 'studentName', 'tutorName', 'tutorTier', 'lastMessage', 'lastMessageAt', 'unreadBy'])
        && request.auth.uid == request.resource.data.studentId
        && request.resource.data.studentId != request.resource.data.tutorId
        && request.resource.data.participantIds == [request.resource.data.studentId, request.resource.data.tutorId]
        && get(/databases/$(database)/documents/users/$(request.resource.data.studentId)).data.role == 'student'
        && get(/databases/$(database)/documents/users/$(request.resource.data.tutorId)).data.role in ['tutor', 'professional']
        && get(/databases/$(database)/documents/tutors/$(request.resource.data.tutorId)).data.verificationStatus == 'approved'
        && request.resource.data.studentName is string && request.resource.data.tutorName is string
        && request.resource.data.tutorTier in ['Peer Tutor', 'Alumni', 'Professor']
        && request.resource.data.lastMessage == '' && request.resource.data.lastMessageAt == request.time
        && request.resource.data.unreadBy == [];
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadBy'])
          && request.resource.data.unreadBy == resource.data.unreadBy.removeAll([request.auth.uid]))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'unreadBy'])
          && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() > 0 && request.resource.data.lastMessage.size() <= 4000
          && request.resource.data.lastMessageAt == request.time
          && request.resource.data.unreadBy == resource.data.participantIds.removeAll([request.auth.uid]))
      );
      match /messages/{messageId} {
        allow read: if participant(id);
        allow create: if participant(id)
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time;
      }
    }
    match /notifications/{id} {
      // Senders can get only their own generated message alerts for retry
      // deduplication; listing is restricted to the recipient.
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/notifications/$(id))
        || resource.data.recipientId == request.auth.uid || sentNotification(resource.data));
      allow list: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if sentNotification(request.resource.data)
        && request.resource.data.keys().hasOnly(['recipientId', 'type', 'title', 'message', 'data', 'read', 'createdAt'])
        && request.resource.data.data.keys().hasOnly(['conversationId', 'messageId'])
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.recipientId in conversation(request.resource.data.data.conversationId).participantIds
        && request.resource.data.title == 'New message'
        && request.resource.data.message == get(/databases/$(database)/documents/conversations/$(request.resource.data.data.conversationId)/messages/$(request.resource.data.data.messageId)).data.text
        && request.resource.data.read == false && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
